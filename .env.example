# Copy to .env and adjust as needed. Never commit .env.
# Image pins (upgrade together after checking release notes)
REDIS_VERSION=7-alpine
POSTGRESQL_VERSION=16
TEMPORAL_VERSION=1.29.1
TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
TEMPORAL_UI_VERSION=2.34.0

# Temporal's internal Postgres credentials (dev defaults; change for any non-local use).
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal
