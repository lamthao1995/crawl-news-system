## Copy to .env (auto-created by run-all.sh / restart-all.sh if missing).
## Never commit .env. These are dev defaults — change for any non-local deploy.

# --- Image pins (upgrade together after checking release notes) ---
REDIS_VERSION=7-alpine
POSTGRESQL_VERSION=16
TEMPORAL_VERSION=1.29.1
TEMPORAL_ADMINTOOLS_VERSION=1.29.1-tctl-1.18.4-cli-1.5.0
TEMPORAL_UI_VERSION=2.34.0

# --- Temporal's internal Postgres credentials (consumed by docker-compose.yml) ---
POSTGRES_USER=temporal
POSTGRES_PASSWORD=temporal

# The rest below are NOT substituted by compose (they are set inline in docker-compose.yml
# under `crawl-worker.environment`). They are documented here so you can see every tunable.
#
# TEMPORAL_PEER_HOST=temporal
# TEMPORAL_PEER_PORT=7233
# TEMPORAL_NAMESPACE=default
# TEMPORAL_TASK_QUEUE=news-task-queue
#
# CRAWL_JDBC_URL=jdbc:postgresql://crawl-postgres:5432/crawl
# CRAWL_JDBC_USER=crawl
# CRAWL_JDBC_PASSWORD=crawl
# REDIS_URL=redis://redis:6379/0
#
# CRAWL_CB_FAILURE_THRESHOLD=5
# CRAWL_CB_OPEN_SECONDS=90
# CRAWL_PER_URL_SLEEP_MS=350
# CRAWL_MAX_BODY_BYTES=4194304   # 4 MiB response cap
#
# WORKER_MAX_ACTIVITIES=16
# WORKER_MAX_WORKFLOW_TASKS=8
# WORKER_MAX_LOCAL_ACTIVITIES=16
